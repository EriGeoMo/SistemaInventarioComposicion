<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SistemaInventarioComposicion.Gui.Views.ConfirmacionWindow"
        Title="Confirmar acción"
        Width="440" Height="200"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <Border Padding="24">
    <Grid RowDefinitions="*,Auto">
      <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="Confirmación" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center"/>
        <TextBlock x:Name="MensajeTexto" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="380" HorizontalAlignment="Center"/>
      </StackPanel>
      <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12" Margin="0,18,0,0">
        <Button Content="Cancelar" Width="120" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="Cancelar_Click"/>
        <Button Content="Aceptar" Width="120" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#1F6BFF" Foreground="White" Click="Aceptar_Click"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
